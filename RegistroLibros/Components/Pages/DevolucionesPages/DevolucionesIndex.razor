@page "/Devoluciones/Index"
@rendermode InteractiveServer
@inject DevolucionesService devolucionesService

<PageTitle>Registro de Devoluciones</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title mt-2">Registro de Devoluciones</h5>
            <a href="/Devoluciones/Crear" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">
                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Id">Id</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Libro">Libro</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property="@(d => d.DevolucionId)" title="Id" Sortable="true" />
                    <PropertyColumn Property="@(d => d.Fecha)" title="Fecha" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(d => d.Prestamo.Estudiante.Nombres)" title="Estudiante" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(d => d.Prestamo.Libro.Titulo)" title="Libro" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones">
                        <a href="/Devoluciones/Modificar/@context.DevolucionId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label><strong>Cantidad: </strong> @itemsQueryable?.Count()</label>
            <label><strong>Promedio de d&iacute;as: </strong>@PromedioDias().ToString("0.0") d&iacute;as</label>
        </div>
    </div>
</div>

@code {
    private IQueryable<Devoluciones> itemsQueryable;
    private Devoluciones devolucion = new();

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var items = await devolucionesService.GetList(d => true);
        itemsQueryable = items.AsQueryable();
    }

    private async Task Eliminar()
    {
        bool eliminado = await estudiantesService.Eliminar(devolucion.DevolucionId);

        if (eliminado)
        {
            var items = await devolucionesService.GetList(d => true);
            itemsQueryable = items.AsQueryable();
            toastService.ShowSuccess("Devolucion eliminada correctamente.");
        }
        else
        {
            toastService.ShowError("Error al eliminar la devolucion.");
        }
    }

    private async Task Buscar()
    {
        if (ValorFiltro == "")
        {
            var items = await devolucionesService.GetList(d => true);
            itemsQueryable = items.AsQueryable();
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Id")
        {
            var Id = await devolucionesService.GetList(d => d.DevolucionId.ToString().Contains(ValorFiltro));
            itemsQueryable = Id.AsQueryable();
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Estudiante")
        {
            var Estudiante = await devolucionesService.GetList(d => d.Prestamo.Estudiante.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Estudiante.AsQueryable();
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Libro")
        {
            var Libro = await devolucionesService.GetList(d => d.Prestamo.Libro.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Libro.AsQueryable();
        }
    }

    private double PromedioDias()
    {
        if (itemsQueryable == null)
        {
            return 0;
        }

        var devoluciones = itemsQueryable
            .Where(d => d.Prestamo != null)
            .ToList();

        if (devoluciones.Count == 0)
        {
            return 0;
        }

        return itemsQueryable
            .Where(d => d.Prestamo != null)
            .Average(d => (d.Fecha.ToDateTime(TimeOnly.MinValue) - d.Prestamo.Fecha.ToDateTime(TimeOnly.MinValue)).TotalDays);
    }
}
