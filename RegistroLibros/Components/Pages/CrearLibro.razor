@page "/crearLibro"
@rendermode InteractiveServer

<PageTitle>Crear Libro</PageTitle>

<EditForm Model="libro" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="p-4 border rounded ">

        <h3>Crear Libro</h3> 
    
        <div class="mb-3 mt-3">
            <label>LibroId</label>
            <InputNumber type="number" class="form-control" @bind-Value="libro.LibroId" readonly />
        </div>
    
        <div class="mb-3">
            <label>Titulo</label>
            <InputText type="text" class="form-control" @bind-Value="libro.Titulo" />
            <ValidationMessage For="() => libro.Titulo" />
        </div>
        
        <div class="mb-3">
            <label>Autor</label>
            <InputText type="text" class="form-control" @bind-Value="libro.Autor" />
            <ValidationMessage For="() => libro.Autor" />
        </div>
    
        <div class="mb-3">
            <label>Año de Publicación</label>
            <InputNumber type="number" class="form-control" @bind-Value="libro.AnioPublicacion" />
            <ValidationMessage For="() => libro.AnioPublicacion" />
        </div>


        <div class ="d-flex justify-content-center gap-4">
            <a href="/IndexLibro" class="btn btn-secondary bi bi-arrow-left mt-5"> Volver</a>
            <button type="submit" class="btn btn-primary mt-5 bi bi-save"> Guardar</button>
        </div>

    </div>
</EditForm>


@code {

    private Libro libro = new Libro();

    private async Task Guardar()
    {
        bool resultado = await libroService.Guardar(libro);

        if (resultado)
        {
            toastService.ShowSuccess("Libro guardado correctamente.");
            libro = new Libro();
        }
        else
        {
            toastService.ShowError("Error al guardar el libro.");
        }
    }
}
