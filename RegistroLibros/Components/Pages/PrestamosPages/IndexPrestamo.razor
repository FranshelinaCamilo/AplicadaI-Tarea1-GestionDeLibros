@page "/Prestamos/Index"
@rendermode InteractiveServer

<PageTitle>Registro de Prestamos</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title mt-2">Registro de Prestamos</h5>
            <a href="/Prestamos/Crear" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">
                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Estudiante">Estudiante</option>
                        <option value="Titulo">T&iacute;tulo</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property="@(p => p.PrestamoId)" title="Id Pr&eacute;stamo" Sortable="true" />
                    <PropertyColumn Property="@(p => p.Fecha)" title="Fecha" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.EstudianteId)" title="Id Estudiante" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.Estudiante.Nombres)" title="Nombre" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.LibroId)" title="Id Libro" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(p => p.Libro.Titulo)" title="T&iacute;tulo" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones">
                        <a href="/Prestamos/Modificar/@context.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label><strong>Cantidad: </strong> @itemsQueryable?.Count()</label>
        </div>

    </div>
</div>

@code {
    private List<Prestamos> ListaPrestamos{ get; set; } = new List<Prestamos>();
    private IQueryable<Prestamos> itemsQueryable;
    private Prestamos prestamo = new();

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await prestamosService.GetList(p => true);
        result.OnSuccess(p => ListaPrestamos = p);
        itemsQueryable = ListaPrestamos.AsQueryable();
    }

    private async Task Buscar()
    {
        if (ValorFiltro == "")
        {
            var result = await prestamosService.GetList(p => true);
            result.OnSuccess(p => ListaPrestamos = p);
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Estudiante")
        {
            var result = await prestamosService.GetList(p => p.Estudiante.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            result.OnSuccess(p => ListaPrestamos = p);
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Titulo")
        {
            var result = await prestamosService.GetList(p => p.Libro.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
            result.OnSuccess(p => ListaPrestamos = p);
        }

        itemsQueryable = ListaPrestamos.AsQueryable();

    }
}
