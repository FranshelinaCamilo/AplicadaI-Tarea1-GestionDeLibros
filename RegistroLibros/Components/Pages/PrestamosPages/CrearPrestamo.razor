@page "/Prestamos/Crear"
@rendermode InteractiveServer

@*HTML*@
<PageTitle>Crear Prestamo</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Crear Pr&eacute;stamo</h5>
            </div>

            <div class="card-body ">
                @*Prestamo*@
                <div class="mb-3">
                    <label class="form-label"><strong>Id</strong></label>
                    <InputNumber class="form-control" @bind-Value="Prestamo.PrestamoId" readonly></InputNumber>
                </div>

                @*Fecha*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.Fecha"></InputDate>
                    <ValidationMessage For="(() => Prestamo.Fecha)" />
                </div>

                @*EstudianteId*@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.EstudianteId" readonly>
                        <option>  Elija una opci&oacute;n  </option>
                        @foreach( var estudiante in estudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @*Libro*@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.LibroId" readonly>
                        <option>  Elija una opci&oacute;n  </option>
                        @foreach (var libro in libros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>
            </div>

            @*footer*@
            <div class="card-footer text-center mt-2">
                <a href="/Prestamos/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>
@Mensaje

@code {
    public Prestamos Prestamo { get; set; } = new Prestamos();
    public string Mensaje { get; set; } = string.Empty;
    public List<Estudiantes> estudiantes { get; set; } = new List<Estudiantes>();
    public List<Libros> libros { get; set; } = new List<Libros>();

    protected override async Task OnInitializedAsync()
    {
        var resultEstudiantes = await estudiantesService.GetList(e => true);
        var resultLibros = await librosService.GetList(l => l.LibroId > 0 && l.Disponible == true);

        resultEstudiantes.OnSuccess(e => estudiantes = e);
        resultLibros.OnSuccess(l => libros = l);
    }

    public async Task Guardar()
    {
        var crearResult = await prestamosService.Guardar(Prestamo);

        crearResult.OnSuccess(() =>
        {
            toastService.ShowSuccess("Préstamo Guardado Correctamente");
            navigationManager.NavigateTo("/Prestamos/Index");
        });
        crearResult.OnFailure(() =>
        {
            toastService.ShowError("No se pudo guardar correctamente");
        }); 
    }
}
