@page "/Prestamos/Modificar/{PrestamoId:int}"
@rendermode InteractiveServer

<PageTitle>Editar Pr&eacute;stamo</PageTitle>
<EditForm Model="Prestamo" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Editar Pr&eacute;stamo</h5>
            </div>

            <div class="card-body">
                @*Prestamo*@
                <div class="mb-3">
                    <label class="form-label"><strong>Id</strong></label>
                    <InputNumber class="form-control" @bind-Value="Prestamo.PrestamoId" readonly></InputNumber>
                </div>

                @*Fecha*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Prestamo.Fecha"></InputDate>
                    <ValidationMessage For="(() => Prestamo.Fecha)" />
                </div>

                @*EstudianteId*@
                <div class="mb-3">
                    <label class="form-label"><strong>Estudiante</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.EstudianteId">
                        <option>  Elija una opci&oacute;n  </option>
                        @foreach (var estudiante in estudiantes)
                        {
                            <option value="@estudiante.EstudianteId">@estudiante.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.EstudianteId)" />
                </div>

                @*Libro*@
                <div class="mb-3">
                    <label class="form-label"><strong>Libro</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Prestamo.LibroId">
                        <option>  Elija una opci&oacute;n  </option>
                        @foreach (var libro in libros)
                        {
                            <option value="@libro.LibroId">@libro.Titulo</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Prestamo.LibroId)" />
                </div>

                @* footer *@
                <div class="card-footer text-center mt-2">
                    <a href="/Prestamos/Index" class="btn btn-secondary mt-2"> <span class="bi bi-arrow-left"></span> Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy mt-2"> Guardar</button>
                    <button type="button" class="btn btn-danger bi bi-trash mt-2" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@*Modal eliminacion*@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (Prestamo != null)
                {

                    <p>¿Esta seguro que desea eliminar este pr&eacute;stamo</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="Eliminar">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int PrestamoId { get; set; }
    private Prestamos Prestamo { get; set; } = new Prestamos();

    private List<Estudiantes> estudiantes { get; set; } = new List<Estudiantes>();
    private List<Libros> libros { get; set; } = new List<Libros>();


    protected override async Task OnInitializedAsync()
    {
        var resultPrestamo = await prestamosService.Buscar(PrestamoId);
        var resultEstudiantes = await estudiantesService.GetList(e => true);
        var resultLibros = await librosService.GetList(l => true);

        resultPrestamo.OnSuccess(p => Prestamo = p);
        resultEstudiantes.OnSuccess(e => estudiantes = e);
        resultLibros.OnSuccess(l => libros = l);
    }

    private async Task Modificar()
    {
        var resultModificado = await prestamosService.Guardar(Prestamo);

        resultModificado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Prestamo modificado correctamente.");
            navigationManager.NavigateTo("/Prestamos/Index");
        });
        resultModificado.OnFailure(() =>
        {
            toastService.ShowError("Error al modificar el prestamo.");
        });
    }

    private async Task Eliminar()
    {
        var resultEliminado = await prestamosService.Eliminar(PrestamoId);

        resultEliminado.OnSuccess(() =>
        {
            toastService.ShowSuccess("Prestamo eliminado correctamente.");
            navigationManager.NavigateTo("/Prestamos/Index");
        });
        resultEliminado.OnFailure(() =>
        {
            toastService.ShowError("Error al eliminar el prestamo.");
        });
    }
}
