@page "/Libros/Index"
@rendermode InteractiveServer

<PageTitle>Registro de Libros</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title mt-2">Registro de Libros</h5>
            <a href="/Libro/Crear" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            @*labels*@
            <div class="row">
                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="LibroId">Id</option>
                        <option value="Titulo">T&iacute;tulo</option>
                        <option value="Autor">Autor</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property="@(e => e.LibroId)" title="Id" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Titulo)" title="Titulo" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Autor)" title="Autor" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.AnioPublicacion)" title="Año de Publicación" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones">
                        <a href="/Libro/Modificar/@context.LibroId" class="btn btn-outline-primary bi bi-pencil-square"></a>

                        <button class="btn btn-outline-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar" @onclick="() => libro = context"></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label class="ms-3"> <strong> Cantidad:</strong>  @itemsQueryable?.Count()</label>
        </div>
    </div>
</div>

@*Modal eliminacion*@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (libro != null)
                {

                    <p>¿Esta seguro que desea eliminar este libro?</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Eliminar">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {
    private IQueryable<Libros> itemsQueryable;
    private Libros libro = new();

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var items = await librosService.GetList(l => true);
        itemsQueryable = items.AsQueryable();
    }

    private async Task Eliminar()
    {

        bool eliminado = await librosService.Eliminar(libro.LibroId);

        if (eliminado)
        {
            var items = await librosService.GetList(l => true);
            itemsQueryable = items.AsQueryable();
            toastService.ShowSuccess("Libro eliminado correctamente.");
        }
        else
        {
            toastService.ShowError("Error al eliminar el libro.");
        }
    }

    private async Task Buscar()
    {
        if (ValorFiltro == "")
        {
            var items = await librosService.GetList(l => true);
            itemsQueryable = items.AsQueryable();
        }
        else if (ValorFiltro.Trim() != "" && Filtro.Trim() == "Autor")
        {
            var Autor = await librosService.GetList(l => l.Autor.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Autor.AsQueryable();
        }
        else if (Filtro.Trim() != "" && Filtro.Trim() == "Titulo")
        {
            var Titulo = await librosService.GetList(l => l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Titulo.AsQueryable();
        }
        else if (Filtro.Trim() != "" && Filtro.Trim() == "LibroId")
        {
            if (int.TryParse(ValorFiltro, out int id))
            {
                var Id = await librosService.GetList(l => l.LibroId == id);
                itemsQueryable = Id.AsQueryable();
            }
        }
    }
}
