@page "/Libro/Crear"
@rendermode InteractiveServer

@*HTML*@
<PageTitle>Crear Libro</PageTitle>
<EditForm Model="Libro" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />


    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Crear Libro</h5>
            </div>

            <div class="card-body ">

                @*LibroId*@
                <div class="mb-3">
                    <label class="form-label"><strong>Id</strong></label>
                    <InputNumber class="form-control" @bind-Value="Libro.LibroId" readonly></InputNumber>
                </div>

                @*Titulo*@
                <div class="mb-3">
                    <label class="form-label"><strong>T&iacute;tulo</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Titulo"></InputText>
                    <ValidationMessage For="(() => Libro.Titulo)" />
                </div>

                @*Autor*@
                <div class="mb-3">
                    <label class="form-label"><strong>Autor</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Autor"></InputText>
                    <ValidationMessage For="(() => Libro.Autor)" />
                </div>

                @*Anio de Publicacion*@
                <div class="mb-3">
                    <label class="form-label"><strong>A&ntilde;o de Publicaci&oacute;n</strong></label>
                    <InputNumber class="form-control" @bind-Value="Libro.AnioPublicacion"></InputNumber>
                    <ValidationMessage For="(() => Libro.AnioPublicacion)" />
                </div>

            </div>

            @*footer*@
            <div class="card-footer text-center mt-2">
                <a href="/Libros/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>
@Mensaje

@code {
    public Libros Libro { get; set; } = new Libros();
    public string Mensaje { get; set; } = string.Empty;

    public async Task Guardar()
    {
        var creado = await librosService.Guardar(Libro);

        if (creado)
        {
            toastService.ShowSuccess("Libro Guardado Correctamente");
            navigationManager.NavigateTo("/Libros/Index");
        }
        else
        {
            toastService.ShowError("No se pudo guardar correctamente");
        }
    }
}
