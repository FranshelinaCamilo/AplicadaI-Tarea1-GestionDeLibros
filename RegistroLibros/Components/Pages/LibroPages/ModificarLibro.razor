@page "/Libro/Modificar/{LibroId:int}"
@rendermode InteractiveServer

<PageTitle>Editar Libro</PageTitle>
<EditForm Model="Libro" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Editar Libro</h5>
            </div>

            <div class="card-body">
                @* LibroId *@
                <div class="mb-3">
                    <label class="form-label"><strong>LibroId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Libro.LibroId" readonly></InputNumber>
                </div>

                @* Titulo *@
                <div class="mb-3">
                    <label class="form-label"><strong>T&iacute;tulo</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Titulo"></InputText>
                </div>

                @* Autor *@
                <div class="mb-3">
                    <label class="form-label"><strong>Autor</strong></label>
                    <InputText class="form-control" @bind-Value="Libro.Autor"></InputText>
                </div>

                @* Anio de Publicacion *@
                <div class="mb-3">
                    <label class="form-label"><strong>A&ntilde;o de Publicaci&oacute;n</strong></label>
                    <InputNumber class="form-control" @bind-Value="Libro.AnioPublicacion"></InputNumber>
                </div>

                @* footer *@
                <div class="card-footer text-center mt-2">
                    <a href="/Libros/Index" class="btn btn-secondary mt-2"> <span class="bi bi-arrow-left"></span> Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy mt-2"> Guardar</button>
                    <button type="button" class="btn btn-danger bi bi-trash mt-2" @onclick="MostrarModal"> Eliminar</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de confirmación *@
<Modal @ref="modal" Title="Confirmar Eliminación">

    <BodyTemplate>
        ¿Está seguro de que desea eliminar el libro "@Libro.Titulo"?
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick"> No </Button>
        <Button Color="ButtonColor.Danger" @onclick="Eliminar"> Si </Button>
    </FooterTemplate>

</Modal>

@code {

    [Parameter]
    public int LibroId { get; set; }

    private Libros Libro = new Libros();

    private Modal modal;

    protected override async Task OnInitializedAsync()
    {
        var libroEncontrado = await librosService.Buscar(LibroId);

        if (libroEncontrado != null)
        {
            Libro = libroEncontrado;
        }
    }

    private async Task Modificar()
    {
        bool modificado = await librosService.Guardar(Libro);

        if (modificado)
        {
            toastService.ShowSuccess("Libro modificado correctamente.");
            navigationManager.NavigateTo("/Libros/Index");
        }
        else
        {
            toastService.ShowError("Error al modificar el libro.");
        
        }
    }

    private async Task MostrarModal()
    {
        await modal.ShowAsync();
    }


    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

   private async Task Eliminar()
    {

        bool Eliminado = await librosService.Eliminar(Libro.LibroId);

        if (Eliminado)
        {
            toastService.ShowSuccess("Libro eliminado correctamente.");
            await modal.HideAsync();
            navigationManager.NavigateTo("/Libros/Index");
        }
        else
        {
            toastService.ShowError("Error al eliminar el libro.");
        }
    }
}
