@page "/Estudiante/Crear"
@rendermode InteractiveServer

@*HTML*@
<PageTitle>Create</PageTitle>
<EditForm Model="Estudiante" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />


    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Crear Libro</h5>
            </div>

            <div class="card-body ">

                @*EstudianteId*@
                <div class="mb-3">
                    <label class="form-label"><strong>Id</strong></label>
                    <InputNumber class="form-control" @bind-Value="Estudiante.EstudianteId" readonly></InputNumber>
                </div>

                @*Nombre*@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombre</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Nombres"></InputText>
                    <ValidationMessage For="(() => Estudiante.Nombres)" />
                </div>

                @*Direccion*@
                <div class="mb-3">
                    <label class="form-label"><strong>Direcci&oacute;n</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Direccion"></InputText>
                    <ValidationMessage For="(() => Estudiante.Direccion)" />
                </div>

                @*Email*@
                <div class="mb-3">
                    <label class="form-label"><strong>Email</strong></label>
                    <InputText class="form-control" typeof="email" @bind-Value="Estudiante.Email"></InputText>
                    <ValidationMessage For="(() => Estudiante.Email)" />
                </div>

                @*Fecha de Nacimiento*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate class="form-control" @bind-Value="Estudiante.FechaNacimiento"></InputDate>
                    <ValidationMessage For="(() => Estudiante.FechaNacimiento)" />
                </div>

            </div>

            @*footer*@
            <div class="card-footer text-center mt-2">
                <a href="/Estudiantes/Index" class="btn btn-secondary"> <span class="bi bi-arrow-left"></span> Volver</a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
            </div>
        </div>
    </div>
</EditForm>

@Mensaje

@code {

    private Estudiantes Estudiante = new Estudiantes();
    public string Mensaje { get; set; } = string.Empty;

    private async Task Guardar()
    {
        bool creado = await estudianteService.Guardar(Estudiante);

        if (creado)
        {
            toastService.ShowSuccess("Estudiante guardado correctamente.");
            navigationManager.NavigateTo("/Estudiantes/Index");
        }
        else if(estudianteService.Buscar(Estudiante.EstudianteId) != null)
        {
            toastService.ShowError("El estudiante ya existe.");
        }
        else
        {
            toastService.ShowError("Error al guardar el estudiante.");
        }
    }
}
