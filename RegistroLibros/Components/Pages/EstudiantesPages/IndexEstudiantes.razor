@page "/Estudiantes/Index"
@rendermode InteractiveServer

<PageTitle>Registro de Estudiantes</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title mt-2">Registro de Estudiantes</h5>
            <a href="/Estudiante/Crear" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">

            @*labels*@
            <div class="row">

                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Id">Id</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Email">Email</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@estudiantes.AsQueryable()">
                    <PropertyColumn Property="@(e => e.EstudianteId)" title="Id" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Nombres)" title="Nombre" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Direccion)" title="Direcci&oacute;n" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Email)" title="Email" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.FechaNacimiento)" title="Fecha de Nacimiento" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones">
                        <a href="/Estudiante/Modificar/@context.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>

                        <button class="btn btn-outline-danger bi bi-trash" @onclick="() => MostrarModal(context)"></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>

        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @estudiantes.Count()</label>
        </div>

    </div>

</div>

@* Modal de confirmación *@
<Modal @ref="modal" Title="Confirmar Eliminación">

    <BodyTemplate>
        ¿Está seguro de que desea eliminar el estudiante "@estudianteSeleccionado.Nombres"?
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick"> No </Button>
        <Button Color="ButtonColor.Danger" @onclick="Eliminar"> Si </Button>
    </FooterTemplate>

</Modal>

@code {
    private List<Estudiantes> estudiantes = new();
    private Estudiantes estudianteSeleccionado = new();
    private Modal modal;

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        estudiantes = await estudiantesService.GetList(e => true);
    }

    private async Task MostrarModal(Estudiantes estudiante)
    {
        estudianteSeleccionado = estudiante;
        await modal.ShowAsync();
    }


    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

    private async Task Eliminar()
    {
        bool eliminado = await estudiantesService.Eliminar(estudianteSeleccionado.EstudianteId);

        if (eliminado)
        {
            estudiantes = await estudiantesService.GetList(e => true);
            toastService.ShowSuccess("Estudiante eliminado correctamente.");
            await modal.HideAsync();
        }
        else
        {
            toastService.ShowError("Error al eliminar el estudiante.");
        }
    }

    private async Task Buscar()
    {
        if (ValorFiltro == "")
        {
            estudiantes = await estudiantesService.GetList(e => true);
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Id")
        {
            estudiantes = await estudiantesService.GetList(e =>
                e.EstudianteId.ToString().Contains(ValorFiltro));
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Nombre")
        {
            estudiantes = await estudiantesService.GetList(e =>
                e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Email")
        {
            estudiantes = await estudiantesService.GetList(e =>
                e.Email.ToLower().Contains(ValorFiltro.ToLower()));
        }

    }
}
