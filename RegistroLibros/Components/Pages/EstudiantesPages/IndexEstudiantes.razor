@page "/Estudiantes/Index"
@rendermode InteractiveServer

<PageTitle>Registro de Estudiantes</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title mt-2">Registro de Estudiantes</h5>
            <a href="/Estudiante/Crear" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">

            @*labels*@
            <div class="row">

                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Id">Id</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Email">Email</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@itemsQueryable">
                    <PropertyColumn Property="@(e => e.EstudianteId)" title="Id" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Nombres)" title="Nombre" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Direccion)" title="Direcci&oacute;n" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Email)" title="Email" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.FechaNacimiento)" title="Fecha de Nacimiento" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones">
                        <a href="/Estudiante/Modificar/@context.EstudianteId" class="btn btn-outline-primary bi bi-pencil-square"></a>

                        <button class="btn btn-outline-danger bi bi-trash"data-bs-toggle ="modal" data-bs-target="#modalEliminar" @onclick="() => estudiante = context"></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>

        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label><strong>Cantidad: </strong> @itemsQueryable?.Count()</label>
        </div>

    </div>

</div>

@*Modal eliminacion*@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (estudiante != null)
                {

                    <p>¿Esta seguro que desea eliminar este estudiante?</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Eliminar">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {
    private IQueryable<Estudiantes> itemsQueryable;
    private Estudiantes estudiante = new();

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var items = await estudiantesService.GetList(e => true);
        itemsQueryable = items.AsQueryable();
    }

    private async Task Eliminar()
    {
        bool eliminado = await estudiantesService.Eliminar(estudiante.EstudianteId);

        if (eliminado)
        {
            var items = await estudiantesService.GetList(e => true);
            itemsQueryable = items.AsQueryable();
            toastService.ShowSuccess("Estudiante eliminado correctamente.");
        }
        else
        {
            toastService.ShowError("Error al eliminar el estudiante.");
        }
    }

    private async Task Buscar()
    {
        if (ValorFiltro == "")
        {
            var items = await estudiantesService.GetList(e => true);
            itemsQueryable = items.AsQueryable();
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Id")
        {
            var Id = await estudiantesService.GetList(e => e.EstudianteId.ToString().Contains(ValorFiltro));
            itemsQueryable = Id.AsQueryable(); 
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Nombre")
        {
            var Nombres = await estudiantesService.GetList(e => e.Nombres.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Nombres.AsQueryable(); 
        }
        else if (ValorFiltro.Trim() != "" && Filtro == "Email")
        {
            var Email = await estudiantesService.GetList(e => e.Email.ToLower().Contains(ValorFiltro.ToLower()));
            itemsQueryable = Email.AsQueryable();
        }

    }
}
