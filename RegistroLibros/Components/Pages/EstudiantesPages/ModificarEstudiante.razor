@page "/Estudiante/Modificar/{EstudianteId:int}"
@rendermode InteractiveServer

<PageTitle>Editar Estudiante</PageTitle>
<EditForm Model="Estudiante" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2">Editar Estudiante</h5>
            </div>

            <div class="card-body">
                @* EstudianteId *@
                <div class="mb-3">
                    <label class="form-label"><strong>EstudianteId</strong></label>
                    <InputNumber class="form-control" @bind-Value="Estudiante.EstudianteId" readonly></InputNumber>
                </div>

                @* Nombres *@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombre</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Nombres"></InputText>
                </div>

                @* Direccion *@
                <div class="mb-3">
                    <label class="form-label"><strong>Direcci&oacute;n</strong></label>
                    <InputText class="form-control" @bind-Value="Estudiante.Direccion"></InputText>
                </div>

                @* Email *@
                <div class="mb-3">
                    <label class="form-label"><strong>Email</strong></label>
                    <InputText class="form-control" typeof="email" @bind-Value="Estudiante.Email"></InputText>
                </div>

                @* Fecha de Nacimiento *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Nacimiento</strong></label>
                    <InputDate TValue="DateOnly" class="form-control" typeof="email" @bind-Value="Estudiante.FechaNacimiento"></InputDate>
                </div>

                @* footer *@
                <div class="card-footer text-center mt-2">
                    <a href="/Estudiantes/Index" class="btn btn-secondary mt-2"> <span class="bi bi-arrow-left"></span> Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy mt-2"> Guardar</button>
                    <button type="button" class="btn btn-danger bi bi-trash mt-2" data-bs-toggle ="modal" data-bs-target="#modalEliminar"> Eliminar</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@*Modal eliminacion*@
<div class="modal" id="modalEliminar" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> Confirmar Eliminaci&oacute;n</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (Estudiante != null)
                {

                    <p>¿Esta seguro que desea eliminar este estudiante?</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Eliminar">Confirmar</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter]
    public int EstudianteId { get; set; }
    private Estudiantes Estudiante = new Estudiantes();

    protected override async Task OnInitializedAsync()
    {
        var estudianteEncontrado = await estudiantesService.Buscar(EstudianteId);

        if (estudianteEncontrado != null)
        {
            Estudiante = estudianteEncontrado;
        }
    }

    private async Task Modificar()
    {
        bool Modificado = await estudiantesService.Guardar(Estudiante);

        if (Modificado)
        {
            toastService.ShowSuccess("Estudiante modificado correctamente."); 
            navigationManager.NavigateTo("/Estudiantes/Index");
        }
        else
        {
            toastService.ShowError("Error al modificar el estudiante.");
        
        }
    }

   private async Task Eliminar()
   {
        bool Eliminado = await estudiantesService.Eliminar(Estudiante.EstudianteId);

        if (Eliminado)
        {
            toastService.ShowSuccess("Estudiante eliminado correctamente.");
            navigationManager.NavigateTo("/Estudiantes/Index");
        }
        else
        {
            toastService.ShowError("Error al eliminar el estudiante.");
        }
    }
}
