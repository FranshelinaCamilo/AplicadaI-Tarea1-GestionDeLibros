@page "/IndexLibro"
@using RegistroLibros.Models
@using RegistroLibros.Services
@using RegistroLibros.Extentors
@inject ToastService toastService
@inject LibroService libroService
@rendermode InteractiveServer

<PageTitle>Libros Registrados</PageTitle>

<ConfirmDialog @ref="dialog" />

<div class="p-3 border rounded">

    <div class=" justify-content-between align-items-lg-center d-flex">
        <h4>Consulta de Libros</h4>
        <a href="/CrearLibro" class="btn btn-primary">Crear +</a>
    </div>

    <div class="p-3 border mt-3">

        <div class="d-flex" style="gap: 185px">
            <label>Filtra por</label>
            <label>Busqueda</label>
        </div>

        <div class="row align-items-center">
            <div class="col-3">
                <select class="form-select" @bind="filtroPor">
                    <option value="" disabled>Selecciona una opcion</option>
                    <option value="LibroId">LibroId</option>
                    <option value="Titulo">Titulo</option>
                    <option value="Autor">Autor</option>
                    <option value="AnioPublicacion">Año Publicacion</option>
                </select>
            </div>

            <div class="col-4">
                <div class="input-group">
                    <input class="form-control" @bind="filtro" placeholder="Buscar" />
                    <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                </div>
            </div>
        </div>

        <table class="table bordered" style="margin-top: 20px;">
            <thead>
                <tr>
                    <th>LibroId</th>
                    <th>Titulo</th>
                    <th>Autor</th>
                    <th>Año Publicacion</th>
                    <th>Opciones</th>
                </tr>          
            </thead>
            <tbody>

                @foreach(var libro in libros){
                    <tr>
                        <td>@libro.LibroId</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td>@libro.AnioPublicacion</td>
                        <td>
                            <a href="@($"/modificarLibro/{libro.LibroId}")" class="btn btn-primary bi bi-pencil-square" ></a>
                            <button class="btn btn-danger bi bi-trash" @onclick="() => Eliminar(libro)"></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p style="margin-top: 10px;">Cantidad: @libros.Count</p>
</div>

@code {

    private ConfirmDialog dialog = default!;
    private List<Libro> libros = new();

    private string filtro { get; set; } = string.Empty;
    private string filtroPor { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        libros = await libroService.GetList(l => true);
    }

    private async Task Eliminar(Libro libro)
    {

        var opciones = new ConfirmDialogOptions
        {
            YesButtonText = "Eliminar",
            YesButtonColor = ButtonColor.Danger,
            NoButtonText = "Cancelar",
            NoButtonColor = ButtonColor.Secondary,
            IsVerticallyCentered = true
        };

        bool confirmar = await dialog.ShowAsync(
            title: "Eliminar libro",
            message1: $"¿Está seguro de que desea eliminar \"{libro.Titulo}\"?",
            confirmDialogOptions: opciones);

        if (!confirmar)
            return;


        bool resultado = await libroService.Eliminar(libro.LibroId);

        if (resultado)
        {
            libros = await libroService.GetList(l => true);
            toastService.ShowSuccess("Libro eliminado correctamente.");
        }
        else
        {
            toastService.ShowError("Error al eliminar el libro.");
        }
    }

    private async Task Buscar()
    {
        if(filtro == "")
        {
            libros = await libroService.GetList(l => true);
        }
        else if (filtro.Trim() != "" && filtroPor == "Autor")
        {
            libros = await libroService.GetList(l =>
                l.Autor.ToLower().Contains(filtro.ToLower()));
        }
        else if (filtro.Trim() != "" && filtroPor == "Titulo")
        {
            libros = await libroService.GetList(l =>
                l.Titulo.ToLower().Contains(filtro.ToLower()));
        }
        else if (filtroPor == "LibroId")
        {
            if (int.TryParse(filtro, out int id))
            {
                libros = await libroService.GetList(l => l.LibroId == id);
            }
        }
        else if (filtroPor == "AnioPublicacion")
        {
            if (int.TryParse(filtro, out int anio))
            {
                libros = await libroService.GetList(l => l.AnioPublicacion == anio);
            }
        }
        
    }


}
