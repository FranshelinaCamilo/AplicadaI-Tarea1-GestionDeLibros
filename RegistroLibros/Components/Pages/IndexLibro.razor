@page "/Libros/Index"
@rendermode InteractiveServer

<PageTitle>Registro de Libros</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title mt-2">Registro de Libros</h5>
            <a href="/Libro/Crear" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">

            @*labels*@
            <div class="row">

                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="Id">ID</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Email">Email</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>

            </div>

            <div class="grid mt-3">
                <QuickGrid Items="@libros.AsQueryable()">
                    <PropertyColumn Property="@(e => e.LibroId)" title="Id" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Titulo)" title="Titulo" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.Autor)" title="Autor" Sortable="true" Align="Align.Left" />
                    <PropertyColumn Property="@(e => e.AnioPublicacion)" title="Año de Publicación" Sortable="true" Align="Align.Left" />
                    <TemplateColumn Title="Opciones">
                        <a href="/Libro/Modificar/@context.LibroId" class="btn btn-outline-primary bi bi-pencil-square"></a>

                        <button class="btn btn-outline-danger bi bi-trash" @onclick="() => MostrarModal(context)"></button>
                    </TemplateColumn>
                </QuickGrid>
            </div>

        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @libros.Count()</label>
        </div>

    </div>

</div>

@* Modal de confirmación *@
<Modal @ref="modal" Title="Confirmar Eliminación">

    <BodyTemplate>
        ¿Está seguro de que desea eliminar el libro "@libroSeleccionado.Titulo"?
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick"> No </Button>
        <Button Color="ButtonColor.Danger" @onclick="Eliminar"> Si </Button>
    </FooterTemplate>

</Modal>

@code {
    private List<Libros> libros = new();
    private Modal modal;
    private Libros libroSeleccionado = new();

    private string Filtro { get; set; } = string.Empty;
    private string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        libros = await libroService.GetList(l => true);
    }

    private async Task MostrarModal(Libros libro)
    {
        libroSeleccionado = libro;
        await modal.ShowAsync();
    }


    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }

    private async Task Eliminar()
    {

        bool eliminado = await libroService.Eliminar(libroSeleccionado.LibroId);

        if (eliminado)
        {
            libros = await libroService.GetList(l => true);
            toastService.ShowSuccess("Libro eliminado correctamente.");
            await modal.HideAsync();
        }
        else
        {
            toastService.ShowError("Error al eliminar el libro.");
        }
    }

    private async Task Buscar()
    {
        if(ValorFiltro == "")
        {
            libros = await libroService.GetList(l => true);
        }
        else if (ValorFiltro.Trim() != "" && Filtro.Trim() == "Autor")
        {
            libros = await libroService.GetList(l =>
                l.Autor.ToLower().Contains(ValorFiltro.ToLower()));
        }
        else if (Filtro.Trim() != "" && Filtro.Trim() == "Titulo")
        {
            libros = await libroService.GetList(l =>
                l.Titulo.ToLower().Contains(ValorFiltro.ToLower()));
        }
        else if (Filtro.Trim() != "" && Filtro.Trim() == "LibroId")
        {
            if (int.TryParse(ValorFiltro, out int id))
            {
                libros = await libroService.GetList(l => l.LibroId == id);
            }
        }
        else if (Filtro.Trim() != "" && Filtro.Trim() == "AnioPublicacion")
        {
            if (int.TryParse(ValorFiltro, out int anio))
            {
                libros = await libroService.GetList(l => l.AnioPublicacion == anio);
            }
        }
        
    }
}
